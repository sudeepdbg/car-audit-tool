# Copy to .env and edit. (Load it with your shell / process manager; the app
# reads these from the environment.)

# Network
HOST=127.0.0.1          # use 0.0.0.0 only behind a TLS reverse proxy
PORT=5000
DEBUG=0
# WSGI=waitress         # serve via waitress (single process) instead of the dev server

# Auth
# JWT_SECRET=           # optional; 32+ random chars. Auto-generated if unset (chmod 0o600).
DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=   # optional; 8+ chars. If unset, a random one is printed once.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SEC=900

# Uploads
MAX_UPLOAD_MB=50        # whole-request size cap (multipart body)
MAX_FILE_MB=50          # per-file size cap (applied to each uploaded file)
MAX_BATCH_PAIRS=20
MAX_IMAGE_PIXELS=60000000

# Trust-score weights (normalised to sum to 1)
AUDIT_W_SSIM=0.4
AUDIT_W_SEMANTIC=0.4
AUDIT_W_PSNR=0.2

AUDIT_DAMAGE_FULL_PCT=5
AUDIT_DAMAGE_MAX_PENALTY=0.75

# Change-detection thresholds (env-tunable). A pixel is "changed" when its
# local structure differs (SSIM map < AUDIT_SSIM_CHANGE_THRESHOLD) AND its
# colour differs (per-channel diff > AUDIT_COLOUR_CHANGE_THRESHOLD).
AUDIT_SSIM_CHANGE_THRESHOLD=0.5
AUDIT_COLOUR_CHANGE_THRESHOLD=30
AUDIT_MIN_REGION_FRAC=0.00005
AUDIT_PSNR_FULL_SCALE=50
# Heatmap colour scale: a grey-level difference of this size is drawn fully red (fixed scale).
AUDIT_HEATMAP_FULL_SCALE=64

# Condition classification boundaries (trust-score bands)
AUDIT_THRESHOLD_EXCELLENT=0.95
AUDIT_THRESHOLD_GOOD=0.85
AUDIT_THRESHOLD_FAIR=0.70
AUDIT_THRESHOLD_POOR=0.50

# Model cache
# TORCH_HOME=./model_cache
# AUDIT_DATA_DIR=./database
LOG_LEVEL=INFO
